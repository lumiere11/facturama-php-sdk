<?xml version="1.0" encoding="UTF-8"?>

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="vendor/autoload.php"
>
    <php>
        <ini name="error_reporting" value="-1" />
        <env name="api_username" value="pruebas" />
        <env name="api_password" value="pruebas2011" />
    </php>

    <testsuites>
        <testsuite name="offline">
            <file>tests/ClientTest.php</file>
            <file>tests/ResourcesTest.php</file>
            <file>tests/LaravelIntegrationTest.php</file>
            <file>tests/Model/Catalog/CatalogsOfflineTest.php</file>
        </testsuite>
        <testsuite name="live">
            <file>tests/Model/Catalog/CfdiTypeTest.php</file>
            <file>tests/Model/Catalog/CfdiUseTest.php</file>
            <file>tests/Model/Catalog/FederalTaxTest.php</file>
            <file>tests/Model/Catalog/PaymentFormTest.php</file>
            <file>tests/Model/Catalog/PaymentMethodTest.php</file>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
