{
    "name": "facturama/facturama-php-sdk",
    "description": "Facturama PHP SDK",
    "keywords": [
        "API",
        "PHP",
        "JSON",
        "Facturama"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://www.api.facturama.com.mx/",
    "support": {
        "issues": "https://github.com/Facturama/facturama-php/issues"
    },
    "authors": [
        {
            "name": "Facturama",
            "email": "dev@facturama.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "orchestra/testbench": "^11.0",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Facturama\\": [
                "src/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Facturama\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0-dev"
        },
        "laravel": {
            "providers": [
                "Facturama\\Laravel\\FacturamaServiceProvider"
            ],
            "aliases": {
                "Facturama": "Facturama\\Laravel\\Facades\\Facturama"
            }
        }
    },
    "suggest": {
        "illuminate/support": "Required (^13.0) to use the Laravel service provider, facade and config."
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist --testsuite offline",
        "test:live": "phpunit -c phpunit.xml.dist --testsuite live",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run -v",
        "md": "phpmd src/ text phpmd.xml.dist"
    }
}
